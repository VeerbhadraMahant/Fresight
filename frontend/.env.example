# Build-time only (Vite inlines VITE_* at build).
# Leave empty to call same-origin /api (works with the dev proxy and with the
# nginx reverse proxy in production). Set to an absolute URL only if the API is
# on a different origin with CORS enabled.
VITE_API_BASE=

# Dev server only: where `npm run dev` proxies /api to.
VITE_DEV_API=http://127.0.0.1:8000

# Live vessel relay (edge/ — Cloudflare Worker + Durable Object). Optional:
# unset -> the map uses 15-min REST polling only. Set to the deployed relay's
# WebSocket URL for real-time positions, e.g.
# VITE_LIVE_WS_URL=wss://freightsight-edge.<your-subdomain>.workers.dev/ws
VITE_LIVE_WS_URL=
