# FreightSight API — all optional. Copy to .env for local overrides.

# Comma-separated allowed CORS origins, or "*" for any (default: *)
FREIGHTSIGHT_CORS_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
FREIGHTSIGHT_LOG_LEVEL=INFO

# "1" to skip the outbound public Baltic Dry Index probe on startup
FREIGHTSIGHT_SKIP_LIVE_PROBE=0

# seconds per public-source request
FREIGHTSIGHT_PROBE_TIMEOUT=4.0
